{
  "_comment": "media-console.a8.net はJSで画面を組み立てるSPAで、同ホストの多数のAPI(/common/timelineなど)を自ら呼び出す作りのため、allowed_hosts配下はGET/HEADを原則許可し、危険なパス(blocked_path_patterns)だけ個別にブロックする方式にしている。static_asset_hostsはA8自身のCDN/付随ドメイン(画像・JS・CSS等の読み込み専用配信元)で、静的ファイル拡張子のGET/HEADのみ許可し、APIパスは許可しない。",

  "allowed_hosts": ["media-console.a8.net"],

  "static_asset_hosts": [
    "a8mc-public.s3.ap-northeast-1.amazonaws.com",
    "support.a8.net",
    "cdn.sheetjs.com"
  ],

  "allowed_methods": ["GET", "HEAD"],

  "static_asset_extensions": [
    "css", "js", "mjs", "png", "jpg", "jpeg", "gif", "svg", "ico", "woff", "woff2", "ttf", "json"
  ],

  "csv_download_path_patterns": [
    "csv",
    "download"
  ],

  "blocked_path_patterns": [
    "apply",
    "entry",
    "cancel",
    "kaijo",
    "setting",
    "profile/edit",
    "mail",
    "withdraw",
    "regist(?!er)",
    "delete",
    "/update"
  ],

  "blocked_tracking_hosts": [
    "^px\\.a8\\.net$",
    "^www[0-9]+\\.a8\\.net$",
    "^b[0-9]*\\.a8\\.net$",
    "^track.*\\.a8\\.net$",
    "^survey\\.a8\\.net$"
  ]
}
