{
  "_comment": "実際のログイン確認で判明: 管理画面のホストは media-console.a8.net。a8mc-public.s3...はA8自身が管理画面の描画に使う静的ファイル(css/js/画像)置き場であり、計測用トラッキングドメインではないため、読み取り専用の静的ファイルに限定して許可している(申請/設定変更等のAPIパスはここには含めない)。プログラム一覧・報酬詳細ページのパスはまだ未確認のため、allowed_path_patterns は要追加(★要検証)。",

  "allowed_hosts": ["media-console.a8.net", "a8mc-public.s3.ap-northeast-1.amazonaws.com"],

  "allowed_methods": ["GET", "HEAD"],

  "allowed_path_patterns": [
    "^/home/?$",
    "\\.(css|js|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|json)$"
  ],

  "csv_download_path_patterns": [
    "csv",
    "download"
  ],

  "blocked_path_patterns": [
    "apply",
    "entry",
    "cancel",
    "kaijo",
    "setting",
    "profile/edit",
    "mail",
    "withdraw",
    "regist",
    "delete",
    "/update"
  ],

  "blocked_tracking_hosts": [
    "^px\\.a8\\.net$",
    "^www[0-9]+\\.a8\\.net$",
    "^b[0-9]*\\.a8\\.net$",
    "^track.*\\.a8\\.net$",
    "^survey\\.a8\\.net$"
  ]
}
