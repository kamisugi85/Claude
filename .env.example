# Slack Incoming Webhook URL。異常検知時の通知に使用する。
# 空のままなら通知は送られない(data/state/alert.json への記録は常に行われる)。
SLACK_WEBHOOK_URL=

# --- 以下は任意設定。通常はデフォルトのままで動作する ---
# A8_LOGIN_URL=https://www.a8.net/
# BROWSER_PROFILE_DIR=./browser_profile
# A8_MAX_CONSECUTIVE_HTTP_ERRORS=3
# A8_REQUEST_TIMEOUT_MS=30000

# ヘッドレス(画面非表示)で実行するかどうか。既定は true。
# サイト側がヘッドレスアクセスを検知して再認証を要求する場合の切り分け用に false を試す。
# A8_HEADLESS=true

# 注意: A8のID/パスワードはこのファイルにも、他のどこにも保存しないこと。
# ログインは `python -m a8_automation.cli login`(または scripts/login.sh)で
# 初回のみ手動で行う。
